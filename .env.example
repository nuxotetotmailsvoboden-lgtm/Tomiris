APP_NAME=TOMIRIS
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://tomiris:tomiris@localhost:5432/tomiris
TOMIRIS_HUB_INGEST_KEY_ID=current
TOMIRIS_HUB_INGEST_SECRET=replace-with-at-least-32-random-characters-for-local-development
TOMIRIS_HUB_PREVIOUS_KEY_ID=
TOMIRIS_HUB_PREVIOUS_SECRET=
AUTH_MAX_CLOCK_SKEW_SECONDS=60
MAX_SIGNAL_TTL_SECONDS=300
MAX_SIGNAL_REQUEST_BYTES=65536
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_AGENT=60
RATE_LIMIT_PER_IP=120
LOG_LEVEL=INFO

