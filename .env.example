APP_NAME=TOMIRIS
APP_VERSION=0.4.0
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://tomiris:tomiris@localhost:5432/tomiris
TOMIRIS_HUB_INGEST_KEY_ID=current
TOMIRIS_HUB_INGEST_SECRET=
TOMIRIS_HUB_PREVIOUS_KEY_ID=
TOMIRIS_HUB_PREVIOUS_SECRET=
AUTH_MAX_CLOCK_SKEW_SECONDS=60
MAX_SIGNAL_TTL_SECONDS=300
MAX_SIGNAL_REQUEST_BYTES=65536
DATABASE_CONNECT_TIMEOUT_SECONDS=5
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_AGENT=60
RATE_LIMIT_PER_IP=120
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BASE_RETRY_SECONDS=5
NOTIFICATION_MAX_RETRY_SECONDS=300
LOG_LEVEL=INFO

# Phase 02 orchestrator (disabled until explicitly started)
ORCHESTRATOR_ENABLED=false
ORCHESTRATOR_INSTANCE_ID=orchestrator-local
ORCHESTRATOR_DISPATCH_BATCH_SIZE=20
ORCHESTRATOR_MAX_IN_FLIGHT=20
ORCHESTRATOR_POLL_INTERVAL_SECONDS=1
AGENT_CONNECT_TIMEOUT_SECONDS=5
AGENT_ACK_TIMEOUT_SECONDS=10
AGENT_COLD_START_GRACE_SECONDS=60
AGENT_SIGNAL_TIMEOUT_SECONDS=300
AGENT_MAX_DISPATCH_ATTEMPTS=5
AGENT_RETRY_BASE_SECONDS=5
AGENT_RETRY_MAX_SECONDS=300
AGENT_CIRCUIT_FAILURE_THRESHOLD=3
AGENT_CIRCUIT_OPEN_SECONDS=120
AGENT_ENDPOINT_ALLOWED_HOST_SUFFIXES=.hf.space,.huggingface.co

# Production: use independent, random roots of at least 32 characters.
AGENT_AUTH_MODE=derived
TOMIRIS_HUB_AGENT_MASTER_SECRET=
TOMIRIS_ORCHESTRATOR_AGENT_MASTER_SECRET=
ORCHESTRATOR_COMMAND_KEY_ID=current

# Universal Agent Runtime / HF Space
TOMIRIS_AGENT_ID=TEST_AGENT_A
TOMIRIS_AGENT_ROLE=test-runtime
TOMIRIS_AGENT_CAPABILITIES=test.echo
TOMIRIS_AGENT_SUPPORTED_ASSETS=TEST
TOMIRIS_HUB_URL=http://127.0.0.1:8000
TOMIRIS_HUB_KEY_ID=current
TOMIRIS_HUB_AGENT_SECRET=
TOMIRIS_ORCHESTRATOR_ID=orchestrator-local
TOMIRIS_ORCHESTRATOR_COMMAND_KEY_ID=current
TOMIRIS_ORCHESTRATOR_COMMAND_SECRET=

# Phase 03 analytical runtime (set only for a pilot analytical Space)
TOMIRIS_RUNTIME_MODE=test
TOMIRIS_AGENT_DEFINITION_PATH=
MARKET_DATA_BASE_URL=https://api.binance.com
MARKET_DATA_CONNECT_TIMEOUT_SECONDS=3
MARKET_DATA_READ_TIMEOUT_SECONDS=8
MARKET_DATA_MAX_ATTEMPTS=3
MARKET_DATA_RETRY_BASE_SECONDS=0.25
MARKET_DATA_RETRY_MAX_SECONDS=2
MARKET_DATA_MAX_RESPONSE_BYTES=2000000
MARKET_DATA_MAX_CONCURRENCY=4
MARKET_DATA_CACHE_TTL_SECONDS=10
MARKET_DATA_ALLOW_INSECURE_LOCALHOST=false

# Phase 04 Market Data Plane (public data only; no exchange credentials)
TOMIRIS_MARKET_EVENT_STORE_MAX_EVENTS=10000
TOMIRIS_MARKET_EVENT_STORE_MAX_BYTES=32000000
TOMIRIS_MARKET_STREAM_QUEUE_MAX_EVENTS=2000
TOMIRIS_MARKET_ORDERBOOK_BUFFER_MAX_EVENTS=2000
TOMIRIS_MARKET_ORDERBOOK_BUFFER_MAX_BYTES=8000000
TOMIRIS_MARKET_ORDERBOOK_BUFFER_MAX_DURATION_SECONDS=30
TOMIRIS_MARKET_CLOCK_DEGRADED_THRESHOLD_MS=500
TOMIRIS_MARKET_CLOCK_UNSAFE_THRESHOLD_MS=2000
TOMIRIS_MARKET_STREAM_RECONNECT_BASE_SECONDS=0.25
TOMIRIS_MARKET_STREAM_RECONNECT_MAX_SECONDS=10
TOMIRIS_MARKET_STREAM_RECONNECT_MAX_ATTEMPTS=10
